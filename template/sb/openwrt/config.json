{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing/docs/schema.json",
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 5335
      },
      {
        "tag": "dns-local",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 5336
      },
      {
        "tag": "dns-fake",
        "type": "fakeip",
        "inet4_range": "11.0.0.0/8"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "dns-local"
      },
      {
        "clash_mode": "Global",
        "server": "dns-remote"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "domain": [
              "project.pages.dev"
            ],
            "invert": true
          },
          {
            "query_type": [
              64,
              65
            ]
          }
        ],
        "action": "predefined",
        "rcode": "NOTIMP"
      },
      {
        "domain": [
          "basic-static-server.infinitynewtab.com"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "domain": [
          "istoreos.home.arpa"
        ],
        "query_type": [
          "A"
        ],
        "action": "predefined",
        "rcode": "NOERROR",
        "answer": [
          "istoreos.home.arpa. 60 IN A 192.168.100.1"
        ]
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "geosite-private"
          },
          {
            "domain_suffix": [
              "4.3.2.7.5.7.1.5.c.c.d.d.ip6.arpa"
            ]
          }
        ],
        "server": "dns-local"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "geosite-category-ads-all"
          }
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "RealIP",
            "invert": true
          },
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "inbound": [
              "dns-real-in"
            ],
            "invert": true
          },
          {
            "rule_set": [
              "geosite-fake-filter"
            ],
            "domain_suffix": [
              "xiaomi.com"
            ],
            "invert": true
          }
        ],
        "action": "route",
        "server": "dns-fake",
        "rewrite_ttl": 1
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-bing"
        ],
        "server": "dns-remote"
      },
      {
        "clash_mode": "GameDirect",
        "rule_set": [
          "geosite-category-games"
        ],
        "domain_keyword": [
          "epic",
          "steam"
        ],
        "server": "dns-local"
      },
      {
        "domain_suffix": [
          "senhewenhua.com",
          "cnmdm.top",
          "akamaized.net",
          "moedot.net",
          "cycani.org",
          "xifanacg.com",
          "skland.com",
          "aliyun.com",
          "online-fix.me"
        ],
        "rule_set": [
          "geosite-cn"
        ],
        "server": "dns-local"
      }
    ],
    "final": "dns-remote",
    "disable_cache": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 20808
    },
    {
      "type": "mixed",
      "tag": "mixed-in2",
      "listen": "::",
      "listen_port": 20809
    },
    {
      "type": "mixed",
      "tag": "mixed-in3",
      "listen": "::",
      "listen_port": 20810
    },
    {
      "type": "mixed",
      "tag": "mixed-in4",
      "listen": "::",
      "listen_port": 20811
    },
    {
      "type": "shadowsocks",
      "tag": "ss-in5",
      "listen": "::",
      "listen_port": 20814,
      "method": "none",
      "password": "none"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-in6",
      "listen": "::",
      "listen_port": 20815,
      "method": "none",
      "password": "none"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-in7",
      "listen": "::",
      "listen_port": 20816,
      "method": "none",
      "password": "none"
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 5339,
      "override_address": "1.1.1.1",
      "override_port": 53
    },
    {
      "type": "direct",
      "tag": "dns-real-in",
      "listen": "::",
      "listen_port": 5340,
      "override_address": "1.1.1.1",
      "override_port": 53
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singbox_tun",
      "address": [
        "172.64.0.1/30",
        "fd6a:7446:b1cd::1/126"
      ],
      "mtu": 65535,
      "auto_route": true,
      "auto_redirect": true,
      "strict_route": true,
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 20808
        }
      }
    }
  ],
  "outbounds": [],
  "route": {
    "default_domain_resolver": {
      "server": "dns-local",
      "strategy": "prefer_ipv6"
    },
    "rules": [
      {
        "inbound": [
          "mixed-in2",
          "ss-in5"
        ],
        "outbound": "proxy"
      },
      {
        "inbound": [
          "mixed-in4",
          "ss-in7"
        ],
        "outbound": "direct"
      },
      {
        "inbound": [
          "dns-in",
          "dns-real-in"
        ],
        "action": "hijack-dns"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "ip_cidr": [
              "192.168.0.0/16",
              "224.0.0.0/3",
              "ddcc:5175:7234::/48",
              "ff00::/8",
              "fe80::/10"
            ]
          },
          {
            "ip_is_private": true
          }
        ],
        "action": "bypass"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "ip_cidr": [
              "192.168.0.0/16",
              "224.0.0.0/3",
              "ddcc:5175:7234::/48",
              "ff00::/8",
              "fe80::/10"
            ]
          },
          {
            "ip_is_private": true
          }
        ],
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "geosite-category-ads-all"
          }
        ],
        "action": "reject",
        "method": "default"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": [
              "geoip-cn"
            ],
            "invert": true
          },
          {
            "network": "udp",
            "port": 443
          }
        ],
        "action": "reject",
        "method": "default"
      },
      {
        "rule_set": "geoip-telegram",
        "outbound": "proxy"
      },
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "bittorrent"
        ],
        "timeout": "500ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "bittorrent"
          }
        ],
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "geosite-private"
          },
          {
            "domain_suffix": [
              "4.3.2.7.5.7.1.5.c.c.d.d.ip6.arpa"
            ]
          }
        ],
        "outbound": "direct"
      },
      {
        "outbound": "proxy",
        "clash_mode": "Global"
      },
      {
        "outbound": "direct",
        "clash_mode": "Direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "geosite-category-ads-all"
          }
        ],
        "action": "reject",
        "method": "default"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "FastMatch"
          },
          {
            "rule_set": [
              "geosite-cn"
            ],
            "invert": true
          },
          {
            "network": "udp",
            "port": 443
          }
        ],
        "action": "reject",
        "method": "default"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "FastMatch",
            "invert": true
          },
          {
            "network": "udp",
            "port": 443
          }
        ],
        "action": "resolve"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": [
              "geoip-cn"
            ],
            "invert": true
          },
          {
            "network": "udp",
            "port": 443
          }
        ],
        "action": "reject",
        "method": "default"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-bing"
        ],
        "outbound": "proxy"
      },
      {
        "clash_mode": "GameDirect",
        "rule_set": [
          "geosite-category-games"
        ],
        "domain_keyword": [
          "epic",
          "steam"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "cycani.org",
          "senhewenhua.com",
          "cnmdm.top",
          "akamaized.net",
          "moedot.net",
          "xifanacg.com",
          "skland.com",
          "aliyun.com",
          "online-fix.me"
        ],
        "outbound": "direct"
      },
      {
        "clash_mode": "FastMatch",
        "rule_set": [
          "geosite-cn"
        ],
        "outbound": "direct"
      },
      {
        "clash_mode": "FastMatch",
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "outbound": "proxy"
      },
      {
        "action": "resolve",
        "match_only": true
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": "geoip-cn"
          },
          {
            "ip_is_private": true
          }
        ],
        "invert": true,
        "outbound": "proxy"
      },
      {
        "action": "resolve",
        "server": "dns-local",
        "strategy": "prefer_ipv6"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-category-games",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-games.srs",
        "path": "/etc/sing-box/srss/geosite-category-games.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-category-ads-all",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs",
        "path": "/etc/sing-box/srss/geosite-category-ads-all.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/private.srs",
        "path": "/etc/sing-box/srss/geosite-private.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
        "path": "/etc/sing-box/srss/geosite-cn.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs",
        "path": "/etc/sing-box/srss/geoip-cn.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geoip-telegram",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs",
        "path": "/etc/sing-box/srss/geoip-telegram.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs",
        "path": "/etc/sing-box/srss/geosite-geolocation-!cn.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-fake-filter",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/DustinWin/ruleset_geodata/sing-box-ruleset/fakeip-filter.srs",
        "path": "/etc/sing-box/srss/geosite-fake-filter.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/google.srs",
        "path": "/etc/sing-box/srss/geosite-google.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-bing",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/bing.srs",
        "path": "/etc/sing-box/srss/geosite-bing.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      }
    ],
    "final": "direct",
    "default_http_client": "proxy-client",
    "auto_detect_interface": true,
    "default_domain_match_strategy": "prefer_fqdn"
  },
  "http_clients": [
    {
      "tag": "proxy-client",
      "detour": "proxy-init"
    },
    {
      "tag": "proxy-provider-client",
      "headers": {
        "User-Agent": "clash-verge/v2.5.2"
      },
      "detour": "proxy-init"
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "/etc/sing-box/ui",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_http_client": "proxy-client"
    }
  },
  "providers": []
}