{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "udp",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "tag": "dns-local",
        "type": "local"
      },
      {
        "tag": "dns-fake",
        "type": "fakeip",
        "inet4_range": "11.0.0.0/8"
      }
    ],
    "rules": [
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "dns-fake",
        "rewrite_ttl": 1
      }
    ],
    "final": "dns-remote"
  },
  "inbounds": [
    {
      "auto_route": true,
      "address": [
        "172.19.0.1/28",
        "fdfe:dcba:9876::1/126"
      ],
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 20808
        }
      },
      "mtu": 65535,
      "tag": "tun-in",
      "type": "tun"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 20808
    },
    {
      "type": "mixed",
      "tag": "mixed-in2",
      "listen": "127.0.0.1",
      "listen_port": 20809
    }
  ],
  "outbounds": [],
  "route": {
    "default_domain_resolver": {
      "server": "dns-local"
    },
    "rules": [
      {
        "inbound": [
          "mixed-in2"
        ],
        "outbound": "proxy"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/private.srs",
        "http_client": "proxy-client",
        "update_interval": "72h0m0s"
      }
    ],
    "final": "proxy",
    "default_http_client": "proxy-client",
    "auto_detect_interface": true
  },
  "http_clients": [
    {
      "tag": "proxy-client",
      "detour": "proxy"
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_download_detour": "proxy"
    }
  }
}